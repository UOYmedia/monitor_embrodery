# Sao chép thành .env (đã nằm trong .gitignore). Không commit file .env thật.
#
# Không có secret nào của controller, Wi-Fi hay token được nhúng vào frontend: Vite chỉ
# đưa biến VITE_* vào bundle, nên mọi biến bên dưới cố tình KHÔNG có tiền tố VITE_.

# Đường dẫn file cấu hình bridge. Mặc định ./bridge.config.json
BRIDGE_CONFIG=./bridge.config.json

# Access token theo vai trò khi auth.mode = "token".
# Tối thiểu 16 ký tự, sinh ngẫu nhiên: openssl rand -base64 32
BRIDGE_TOKEN_VIEWER=
BRIDGE_TOKEN_TECH=
BRIDGE_TOKEN_ADMIN=
