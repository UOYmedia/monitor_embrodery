        {
          "id": 111,
          "type": "table",
          "title": "🔴 Im hoặc lỗi — bridge nói gì",
          "description": "Cột \"Bridge nói gì\" chép nguyên văn câu bridge tự nhận xét — đọc câu ấy trước khi kết luận máy hỏng.",
          "datasource": {
            "type": "loki",
            "uid": "loki-dahao"
          },
          "gridPos": {
            "h": 7,
            "w": 24,
            "x": 0,
            "y": 32
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "(last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap mui [3m]) by (may))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 0) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 2) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 7) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 9))",
              "queryType": "instant",
              "format": "table"
            },
            {
              "refId": "B",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "(last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap tong [3m]) by (may))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 0) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 2) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 7) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 9))",
              "queryType": "instant",
              "format": "table"
            },
            {
              "refId": "C",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "(last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 0) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 2) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 7) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 9))",
              "queryType": "instant",
              "format": "table"
            },
            {
              "refId": "D",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "(sum by (may, ten, mau, loi_text) (count_over_time({job=\"tinh-trang\", may=~\"$may\"} [45s])))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 0) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 2) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 7) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 9))",
              "queryType": "instant",
              "format": "table"
            },
            {
              "refId": "E",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "(last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap giay [3m]) by (may))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 0) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 2) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 7) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 9))",
              "queryType": "instant",
              "format": "table"
            },
            {
              "refId": "F",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap mui [3m]) by (may)) / (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap tong [3m]) by (may) > 0))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 0) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 2) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 7) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 9))",
              "queryType": "instant",
              "format": "table"
            },
            {
              "refId": "G",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "((last_over_time({job=\"va-mau\", may=~\"$may\", viec=~\"mo|dang\"} | unwrap ma_nghi [1m]) by (may)) and on (may) (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) <= 1))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 0) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 2) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 7) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 9))",
              "queryType": "instant",
              "format": "table"
            }
          ],
