            "uid": "loki-dahao"
          },
          "expr": "count((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 3) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 4) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 5)) or vector(0)",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
