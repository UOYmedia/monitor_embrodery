              },
              "expr": "(sum by (may, ten, mau) (count_over_time({job=\"tinh-trang\", may=~\"$may\"} [45s])))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 6))",
