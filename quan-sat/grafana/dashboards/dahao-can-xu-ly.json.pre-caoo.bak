{
  "uid": "dahao-can-xu-ly",
  "title": "Dahao — cần xử lý",
  "tags": [
    "dahao",
    "xuong",
    "xu-ly"
  ],
  "description": "Máy nào cần người ra tay, tách theo LOẠI VIỆC phải làm.",
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 0,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "may",
        "label": "Máy",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki-dahao"
        },
        "query": "label_values({job=\"tinh-trang\"}, may)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "definition": "label_values({job=\"broker\", loai=\"trang-thai\"}, may)"
      }
    ]
  },
  "panels": [
    {
      "id": 101,
      "type": "stat",
      "title": "Dừng giữa mẫu",
      "description": "Máy đang dở tấm mà đứng im. Đây là nhóm CẦN RA XEM NGAY.",
      "datasource": {
        "type": "loki",
        "uid": "loki-dahao"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-dahao"
          },
          "expr": "count((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 1)) or vector(0)",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "text": {
          "titleSize": 16,
          "valueSize": 56
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Im hoặc lỗi — cần ra xem",
      "description": "Máy không còn gửi tin VÀ đó là chuyện cần ra tay: mất tín hiệu giữa lúc thêu dở (mã 2), bridge gọi không ai nhấc (mã 7), cả xưởng cùng im vì cúp điện hoặc đứt mạng (mã 9), hoặc chính đường đo hỏng (mã 0). Xem cột \"Bridge nói gì\" ở bảng dưới.\n\nCỐ Ý KHÔNG đếm: máy tắt ngoài giờ làm (mã 8) và thợ tắt máy sau khi thêu xong tấm (mã 10). Hai cái đó là chuyện bình thường; kéo vào đây thì đêm nào bảng cũng đỏ và người ta thôi nhìn nó. Muốn đếm đủ mọi máy đang im thì xem ô \"Máy im\" bên bảng Tình trạng.",
      "datasource": {
        "type": "loki",
        "uid": "loki-dahao"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-dahao"
          },
          "expr": "count((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 0) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 2) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 7) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 9)) or vector(0)",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "text": {
          "titleSize": 16,
          "valueSize": 56
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Xong tấm / chờ việc",
      "description": "Máy khỏe nhưng không có việc. Cần nạp mẫu mới hoặc thay khung.",
      "datasource": {
        "type": "loki",
        "uid": "loki-dahao"
      },
      "gridPos": {
