              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 120,
      "type": "stat",
      "title": "🟠 ĐANG DỪNG GIỮA MẪU — ra xem ngay",
      "description": "Mỗi thẻ một máy đang dở tấm mà đứng im. Chữ dưới tên là SUY LUẬN từ số mũi — máy không tự báo lỗi bao giờ.",
      "datasource": {
        "type": "loki",
        "uid": "loki-dahao"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-dahao"
          },
          "expr": "(last_over_time({job=\"va-mau\", may=~\"$may\", viec=~\"mo|dang\"} | unwrap ma_nghi [2m]) by (may))\n  * on (may) group_left(ten) (0 * ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may, ten) == 1)) + 1)\n  or (0 * ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may, ten) == 1)) + 90)",
          "queryType": "range",
          "legendFormat": "{{ten}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "wideLayout": true,
        "percentChangeColorMode": "standard",
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 22
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "nghi đứt chỉ — đang vá",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "dừng hẳn, chưa chạy lại",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "dừng lâu, không lùi mũi",
                  "color": "yellow",
                  "index": 2
                },
                "3": {
                  "text": "dừng thoáng",
                  "color": "text",
                  "index": 3
                },
                "4": {
                  "text": "đổi mẫu",
                  "color": "blue",
                  "index": 4
                },
                "5": {
                  "text": "mất tin",
                  "color": "purple",
                  "index": 5
                },
                "6": {
                  "text": "làm tấm mới",
                  "color": "green",
                  "index": 6
                },
                "90": {
                  "text": "đang dừng — chưa rõ vì sao",
                  "color": "orange",
                  "index": 90
                }
              }
            }
          ],
          "noValue": "Không có máy nào"
        },
        "overrides": []
      },
      "timeFrom": "5m"
    },
    {
      "id": 121,
      "type": "stat",
      "title": "🔴 IM HOẶC LỖI — cần ra xem (số là ĐÃ THẾ BAO LÂU)",
      "description": "Không kết luận được là máy hỏng: có thể máy tắt, rớt mạng, hoặc chính đường đo hỏng. Mở \"Chi tiết\" ở dưới để đọc nguyên văn bridge nói gì.",
      "datasource": {
        "type": "loki",
        "uid": "loki-dahao"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki-dahao"
          },
          "expr": "(last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap giay [3m]) by (may, ten))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 0) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 2) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 7) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 9))",
          "queryType": "range",
          "legendFormat": "{{ten}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
