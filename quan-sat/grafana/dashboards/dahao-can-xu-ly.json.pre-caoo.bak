          },
          "expr": "(last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap giay [3m]) by (may, ten))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 3) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 4) or (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 5))",
