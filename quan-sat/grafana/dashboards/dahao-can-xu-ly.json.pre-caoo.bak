    {
      "collapsed": true,
      "type": "row",
      "id": 130,
      "title": "Chi tiết — bảng chữ nhỏ, mẫu, mũi, nhật ký (bấm để mở)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "panels": [
        {
          "id": 110,
          "type": "table",
          "title": "🟠 Đang dừng giữa mẫu — mẫu, mũi, bao lâu",
          "description": "Máy đang dở tấm mà số mũi đứng im. Cột \"Vì sao dừng\" là SUY LUẬN từ số mũi (máy không tự báo lỗi) — \"nghi đứt chỉ\" nghĩa là đã có người lùi khung để vá.",
          "datasource": {
            "type": "loki",
            "uid": "loki-dahao"
          },
          "gridPos": {
            "h": 7,
            "w": 24,
            "x": 0,
            "y": 25
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "(last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap mui [3m]) by (may))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 1))",
              "queryType": "instant",
              "format": "table"
            },
            {
              "refId": "B",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "(last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap tong [3m]) by (may))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 1))",
              "queryType": "instant",
              "format": "table"
            },
            {
              "refId": "C",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "(last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 1))",
              "queryType": "instant",
              "format": "table"
            },
            {
              "refId": "D",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "(sum by (may, ten, mau) (count_over_time({job=\"tinh-trang\", may=~\"$may\"} [45s])))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 1))",
              "queryType": "instant",
              "format": "table"
            },
            {
              "refId": "E",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "(last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap giay [3m]) by (may))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 1))",
              "queryType": "instant",
              "format": "table"
            },
            {
              "refId": "F",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap mui [3m]) by (may)) / (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap tong [3m]) by (may) > 0))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 1))",
              "queryType": "instant",
              "format": "table"
            },
            {
              "refId": "G",
              "datasource": {
                "type": "loki",
                "uid": "loki-dahao"
              },
              "expr": "((last_over_time({job=\"va-mau\", may=~\"$may\", viec=~\"mo|dang\"} | unwrap ma_nghi [1m]) by (may)) and on (may) (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) <= 1))\n  and on (may) ((last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) == 1))",
              "queryType": "instant",
              "format": "table"
            }
          ],
          "transformations": [
            {
              "id": "filterFieldsByName",
              "options": {
                "include": {
                  "pattern": "^(may|ten|mau|Value.*)$"
                }
              }
            },
            {
              "id": "joinByField",
              "options": {
                "byField": "may",
                "mode": "outer"
              }
            },
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Value #B": true,
                  "may": true,
                  "Value #C": true
                },
                "renameByName": {
                  "ten": "Máy",
                  "may": "Mã máy",
                  "Value #C": "Tình trạng",
                  "Value #G": "Vì sao dừng",
