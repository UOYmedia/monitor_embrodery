          "expr": "last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap giay [3m]) by (may)",
          "queryType": "instant",
          "format": "table"
        },
        {
          "refId": "F",
          "datasource": {
            "type": "loki",
            "uid": "loki-dahao"
          },
          "expr": "(last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap mui [3m]) by (may)) / (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap tong [3m]) by (may) > 0)",
