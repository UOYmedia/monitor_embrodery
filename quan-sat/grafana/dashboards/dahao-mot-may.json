            "uid": "loki-dahao"
          },
          "expr": "(last_over_time({job=\"va-mau\", may=~\"$may\", viec=~\"mo|dang\"} | unwrap ma_nghi [1m]) by (may)) and on (may) (last_over_time({job=\"tinh-trang\", may=~\"$may\"} | json | unwrap ma [3m]) by (may) <= 1)",
