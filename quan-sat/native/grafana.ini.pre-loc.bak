; Grafana chạy THẲNG trên macOS (brew), không container.
; Bản container đặt các thứ này bằng biến môi trường GF_* trong docker-compose.yml;
; bản native đặt bằng file ini để plist launchd không phải ôm một đống biến.
;
; MẬT KHẨU admin KHÔNG nằm trong file này — nó ở ~/dahao-gateway/quan-sat/grafana-admin.env
; (chmod 600) và được `chay-grafana.sh` nạp vào biến môi trường. Cùng cách làm
; với token bridge: bí mật đúng một chỗ, không nhân bản vào file ai cũng đọc được.

[paths]
data         = /Users/phong/dahao-gateway/quan-sat/du-lieu/grafana
logs         = /Users/phong/dahao-gateway/quan-sat/du-lieu/grafana/log
plugins      = /Users/phong/dahao-gateway/quan-sat/du-lieu/grafana/plugins
provisioning = /Users/phong/dahao-gateway/quan-sat/native/provisioning

[server]
protocol  = http
; CHỈ nghe trên địa chỉ tailnet. Đổi sang 0.0.0.0 là mở ra cả LAN xưởng —
; Grafana đọc được log thô, khác hẳn trang xem vốn chỉ hiện con số. Cân nhắc trước khi đổi.
; Không có hostname nào của bộ này trong cloudflare-config.yml: tunnel chỉ trỏ cổng 8790.
http_addr = 100.107.219.95
http_port = 3000
; Đường vào chính thức từ ngoài. Không có dòng này thì đăng nhập xong Grafana đá về
; http://100.107.219.95:3000 — địa chỉ tailnet, ngoài xưởng không với tới.
; KHÔNG bật security.cookie_secure: đường tailnet là http trần, bật lên là không đăng nhập được
; từ trong xưởng nữa. Tailnet đã mã hoá ở tầng dưới.
root_url  = https://grafana.phonh.io.vn/

[auth.anonymous]
; TẮT từ 27/08, lúc mở grafana.phonh.io.vn ra internet.
;
; Trước đó bật là hợp lý vì Grafana chỉ nghe trong tailnet — ai vào được tailnet thì đã là người
; nhà. Ra internet thì khác hẳn: Grafana đọc LOG THÔ (tên file mẫu, MAC máy, cảnh báo bridge),
; không phải chỉ con số như trang `xem/`. Để mở là ai dò trúng tên miền cũng đọc được.
;
; Grafana có sẵn chống dò mật khẩu (khoá 5 phút sau 5 lần sai) — để mặc định, đừng tắt.
enabled  = false
org_name = Main Org.
org_role = Viewer

[users]
allow_sign_up = false
default_theme = dark

[dashboards]
; Mở Grafana là ra thẳng bảng VẬN HÀNH (đang chạy / đang lỗi / cảnh báo / nghi đứt chỉ),
; không phải bảng kỹ thuật `dahao-tuyen` (bảng ấy đo ĐƯỜNG ỐNG: nhịp bản tin, API bị từ chối —
; người ở xưởng mở lên chỉ thấy mấy con số 0 và không hiểu gì). Preference của org trong CSDL
; thắng dòng này; đặt cả hai để cài mới trên máy trắng cũng ra đúng bảng.
default_home_dashboard_path = /Users/phong/dahao-gateway/quan-sat/grafana/dashboards/dahao-xem-nhanh.json

[analytics]
; Không gọi về nhà, không hỏi bản mới — máy này là máy sản xuất.
reporting_enabled           = false
check_for_updates           = false
check_for_plugin_updates    = false
feedback_links_enabled      = false

[news]
news_feed_enabled = false

[log]
mode  = console file
level = info
